# JUBART — MODELO PARA INSTALAÇÃO LOCAL
# Início recomendado: ./install.sh (cria o .env automaticamente se necessário).
# Alternativa: copie este arquivo para .env e execute scripts/initialize-local.mjs
# com Node.js 24 ou com o comando Docker documentado no README.
# ./install.sh pergunta usuário/senha, pasta dos projetos, porta, acesso, fuso e bancos.
# --non-interactive gera credenciais sem perguntas; instalações existentes são preservadas.
# O inicializador troca os marcadores de senha e caminhos pelos valores locais.
# Após entrar, configure no assistente e use Administração → Manutenção do painel
# → Iniciar serviços para executar docker compose up -d --build.
# Não publique seu .env nem use as senhas de exemplo em uma instalação ativa.
# Configuração padrão para desenvolvimento local.
# Aplicação: http://localhost | Painel: http://localhost:9090
# phpMyAdmin: http://localhost:8081 | HTTPS local desativado.
# Ajuste os caminhos do host e gere suas credenciais antes de iniciar.
# Se a porta 80 estiver ocupada, use 8080 e atualize APP_URL e as URLs adicionais.

# -----------------------------------------------------------------------------
# SERVIÇOS E PROJETO
# -----------------------------------------------------------------------------
# Bancos opcionais: true para iniciar, false para desativar (volumes preservados).
# Ambos=true mantém o padrão; ambos=false permite usar bancos externos ou nenhum.
# Mantenha db-mariadb-true,db-postgres-true no COMPOSE_PROFILES abaixo.
MARIADB_ENABLED=true
POSTGRES_ENABLED=true

# Nome do projeto Docker Compose
COMPOSE_PROJECT_NAME=laravel

# Diretório da aplicação Laravel no host (absoluto ou relativo a este compose).
# Deve conter artisan, composer.json e public/index.php.
APP_DIRECTORY=./app

# -----------------------------------------------------------------------------
# IMAGENS FIXADAS
# -----------------------------------------------------------------------------
# Imagens
# Versão exata do PHP usada no download da imagem FrankenPHP
# Ao atualizar: docker compose build --pull php && docker compose up -d --no-deps --force-recreate php
# A combinação FRANKENPHP_VERSION + PHP_VERSION deve existir no registro de imagens
PHP_VERSION=8.4.27
MARIADB_VERSION=11.4@sha256:d1891ede5a559f1086f55053bb8cc1569b0298338c4d72d71725a7f74f6ba620

# -----------------------------------------------------------------------------
# ACESSO À APLICAÇÃO E PHP
# -----------------------------------------------------------------------------
# Acesso HTTP/HTTPS via Traefik
# Local: 127.0.0.1 | VPS com acesso público direto: 0.0.0.0
# As portas abaixo são publicadas pelo Traefik; FrankenPHP fica na rede interna.
# Padrão local: 127.0.0.1 | VPS pública: 0.0.0.0
HTTP_BIND_ADDRESS=127.0.0.1
# Padrão local: 80 (acesso sem informar porta no navegador)
HTTP_PORT=80
# URL pública usada pelo Laravel; ajuste junto com porta/domínio e HTTPS
# Local: http://localhost | VPS com TLS: https://app.seudominio.com
APP_URL=http://localhost

# PHP
TZ=America/Sao_Paulo
# Região para exibir datas na área Configurações do servidor (não altera idioma das aplicações).
SERVER_DATE_LOCALE=pt-BR
PHP_MEMORY_LIMIT=256M
PHP_UPLOAD_MAX_FILESIZE=32M
PHP_POST_MAX_SIZE=40M
PHP_MAX_EXECUTION_TIME=60


# MariaDB: acesso apenas pela rede Docker, em mariadb:3306
# FrankenPHP/Octane: HTTP interno em php:8000; admin 2019 não publicado.
# Essas portas internas não são publicadas no host.
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# -----------------------------------------------------------------------------
# PHPMYADMIN
# -----------------------------------------------------------------------------
# phpMyAdmin
# Mantenha 127.0.0.1 também na VPS; acesse por túnel SSH.
PHPMYADMIN_VERSION=5.2-apache@sha256:f54a37b908b26caa7032c4eb0c7f3495fdd90208a06eed9c4b2c8e691dd1662c
PHPMYADMIN_BIND_ADDRESS=127.0.0.1
PHPMYADMIN_PORT=8081
# Arquivo de importação (MiB). Para um SQL de 50 MiB, use margem acima desse tamanho.
PHPMYADMIN_UPLOAD_LIMIT=128M
# Memória PHP para importar/exportar; não reserva RAM no host.
PHPMYADMIN_MEMORY_LIMIT=512M
# Tempo máximo por operação (segundos). Downloads não têm teto de bytes.
PHPMYADMIN_MAX_EXECUTION_TIME=600

# -----------------------------------------------------------------------------
# NODE.JS E PROXY
# -----------------------------------------------------------------------------
# Node.js com npm para instalar dependências e compilar assets
NODE_VERSION=24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9
# Ajuste conforme id -u e id -g do usuário do host
NODE_UID=1000
NODE_GID=1000

# Traefik Proxy gratuito (open source)
TRAEFIK_VERSION=v3.7@sha256:f4bb143d1135a579b630ed491e17ec50f6f7c9c6a30585ff3d385471d2a86f5a
# Domínio sem protocolo e sem porta; deve corresponder ao host de APP_URL
# Local: localhost | VPS: app.seudominio.com (sem protocolo/porta)
APP_DOMAIN=localhost
# Local: 8443 (não usado com TLS=false) | VPS com TLS: 443
HTTPS_PORT=8443
# Local: false | VPS com domínio público e Let's Encrypt: true
TRAEFIK_TLS_ENABLED=false
# Obrigatório para solicitar certificados na VPS
# Local: vazio | VPS com TLS: seu email válido para a conta ACME
ACME_EMAIL=
TRAEFIK_LOG_LEVEL=INFO

# Sessões nativas PHP (Laravel tem SESSION_* no .env da aplicação)
# Local HTTP: 0 | VPS HTTPS: 1; Laravel: SESSION_SECURE_COOKIE=true no .env da aplicação
PHP_SESSION_COOKIE_SECURE=0
PHP_SESSION_GC_MAXLIFETIME=7200

# OPcache (memória em MB)
PHP_OPCACHE_MEMORY=128


# FrankenPHP: traditional não exige Octane; octane exige pacote na aplicação
PHP_SERVER_MODE=traditional
# Configurações abaixo de workers só se aplicam ao modo octane
FRANKENPHP_VERSION=1
OCTANE_WORKERS=2
OCTANE_MAX_REQUESTS=500


# Valkey 8: somente rede interna Docker, sem porta publicada no host
VALKEY_VERSION=8-alpine@sha256:2602ace2be6569bc2bbb06f873776516ab9089821525be34f4305c67eb9db02a
VALKEY_PORT=6379
VALKEY_PASSWORD=troque-esta-senha-valkey
VALKEY_MAXMEMORY=256mb
# noeviction evita descarte automático de sessões/filas ao atingir o limite
VALKEY_MAXMEMORY_POLICY=noeviction
VALKEY_APPENDONLY=yes
VALKEY_APPENDFSYNC=everysec

# Serviços frontend opcionais: vazio, vite, ssr ou vite,ssr
# VPS em produção: sem vite; use ssr apenas se a aplicação suportar SSR
COMPOSE_PROFILES=db-mariadb-true,db-postgres-true

# Vite/HMR: desenvolvimento local
VITE_NPM_SCRIPT=dev
VITE_BIND_ADDRESS=127.0.0.1
VITE_PORT=5173
VITE_HMR_HOST=localhost
VITE_HMR_PROTOCOL=ws
VITE_HMR_CLIENT_PORT=5173
VITE_USE_POLLING=false

# Inertia SSR: exige bundle SSR preparado na aplicação
INERTIA_SSR_ENABLED=false
SSR_PORT=13714
SSR_BUNDLE=bootstrap/ssr/ssr.js

# -----------------------------------------------------------------------------
# BACKUPS MARIADB
# -----------------------------------------------------------------------------
# Backup automático MariaDB (pasta do host; não use o diretório da aplicação)
BACKUP_ENABLED=false
BACKUP_DIRECTORY=./backups/mariadb
# Cron: minuto hora dia-do-mês mês dia-da-semana (todos os dias às 03h)
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_TIMEZONE=America/Sao_Paulo
BACKUP_RUN_ON_START=false
# 0 desativa remoção local por idade
BACKUP_RETENTION_DAYS=14
# Saúde: deve ser maior que o intervalo entre backups + margem
BACKUP_MAX_AGE_HOURS=48

# Envio opcional para AWS S3 ou serviço compatível; desativado por padrão
BACKUP_REMOTE_ENABLED=false
BACKUP_REMOTE_PREFIX=laravel/mariadb
BACKUP_S3_PROVIDER=AWS
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
# AWS: vazio. S3 compatível: URL HTTPS do endpoint, provider Other
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# true para autenticação pela cadeia AWS (ex.: IAM role), false para chaves acima
BACKUP_S3_ENV_AUTH=false

# -----------------------------------------------------------------------------
# DRIVERS E APLICAÇÕES ADICIONAIS
# -----------------------------------------------------------------------------
# Drivers opcionais PHP: false = não solicitar instalação adicional
# pdo_mysql (MariaDB) e redis (Valkey) continuam na lista básica.
# SQL Server via ODBC Microsoft bloqueado: manter false (política open source).
# Habilitar implica instalação sujeita aos termos do driver Microsoft.
PHP_INSTALL_SQLSERVER=false
# -----------------------------------------------------------------------------
# POSTGRESQL E BACKUPS
# -----------------------------------------------------------------------------
# PostgreSQL: pgsql + pdo_pgsql
PHP_INSTALL_POSTGRESQL=false
# SQLite: sqlite3 + pdo_sqlite (a imagem base pode já fornecê-los)
PHP_INSTALL_SQLITE=false
# MySQL/MariaDB procedural: mysqli (Laravel já usa pdo_mysql)
PHP_INSTALL_MYSQLI=false
# Após alterar: docker compose build --pull php
# Depois: docker compose up -d --no-deps --force-recreate php

# Diagnóstico PHP: On exibe erros/arquivos/linhas e preserva a resposta Laravel.
# Use SOMENTE localmente. VPS/produção: Off e APP_DEBUG=false na aplicação.
PHP_DISPLAY_ERRORS=Off

# Aplicação principal: continua em APP_DIRECTORY / APP_DOMAIN, container php
# PHP convencional: /var/www/html | Laravel: /var/www/html/public
PHP_DOCUMENT_ROOT=/var/www/html/public
APP_REDIS_PREFIX=primary_
APP_REDIS_DB=0
APP_REDIS_CACHE_DB=1

# Aplicações extras opcionais (até duas nesta configuração)
# Ative em COMPOSE_PROFILES: app2 ou app2,app3 (combine com vite/ssr se necessário)
# Os domínios compartilham HTTP_PORT: porta 80 dispensa :porta na URL.

# Aplicação extra 2: perfil app2, container php-app2
APP_2_DIRECTORY=./app2
APP_2_DOMAIN=app2.localhost
# Se HTTP_PORT não for 80, inclua :porta aqui e no navegador
APP_2_URL=http://app2.localhost
APP_2_SERVER_MODE=traditional
APP_2_DOCUMENT_ROOT=/var/www/html/public
APP_2_DB_DATABASE=app2
APP_2_DB_USERNAME=app2
APP_2_DB_PASSWORD=troque-esta-senha-app2
APP_2_REDIS_PREFIX=app2_
APP_2_REDIS_DB=2
APP_2_REDIS_CACHE_DB=3

# Aplicação extra 3: perfil app3, container php-app3
APP_3_DIRECTORY=./app3
APP_3_DOMAIN=app3.localhost
# Se HTTP_PORT não for 80, inclua :porta aqui e no navegador
APP_3_URL=http://app3.localhost
APP_3_SERVER_MODE=traditional
APP_3_DOCUMENT_ROOT=/var/www/html/public
APP_3_DB_DATABASE=app3
APP_3_DB_USERNAME=app3
APP_3_DB_PASSWORD=troque-esta-senha-app3
APP_3_REDIS_PREFIX=app3_
APP_3_REDIS_DB=4
APP_3_REDIS_CACHE_DB=5

# -----------------------------------------------------------------------------
# PAINEL ADMINISTRATIVO
# -----------------------------------------------------------------------------
# Painel administrativo: HTTP direto em http://localhost:9090, sem domínio/TLS.
# Na VPS, escolha 0.0.0.0 para acesso por IP e libere PANEL_PORT no firewall.
# Possui controle do Docker deste projeto.
PANEL_USERNAME=admin
PANEL_PASSWORD=troque-por-uma-senha-forte-com-16-caracteres
PANEL_BIND_ADDRESS=127.0.0.1
PANEL_PORT=9090
# ./install.sh já executa a preparação usando Docker, sem Node.js no host.
# Na preparação manual, execute o inicializador antes do primeiro docker compose.
# O inicializador substitui os caminhos abaixo e gera senhas locais únicas.
# Caminhos absolutos existentes no SEU host:
# WORKSPACE = raiz deste repositório; PROJECTS = pasta que contém suas aplicações.
# O inicializador cria ./projects para aplicações e ./app para a principal.
PANEL_WORKSPACE_DIRECTORY=/caminho/absoluto/infra-comserv
PANEL_PROJECTS_DIRECTORY=/caminho/absoluto/projetos
# false no HTTP local; true somente ao fornecer HTTPS ao painel
PANEL_COOKIE_SECURE=false

# Portas HTTP internas dos servidores; o proxy acompanha estes valores
PHP_HTTP_PORT=8000
APP_2_HTTP_PORT=8000
APP_3_HTTP_PORT=8000

# Inclui workers/Scheduler gerados pelo painel no Compose padrão.
# Linux/VPS: separador ':' (COMPOSE_PATH_SEPARATOR pode ajustar outras plataformas).
COMPOSE_FILE=compose.yaml:config/automation.compose.json:config/apps.compose.yaml

# Terminal administrativo: sessão TTY interativa dentro dos containers
# Habilite apenas para administradores; cada comando pode alterar a aplicação.
PANEL_TERMINAL_ENABLED=true

# Métricas do painel: amostragem sob demanda (3000 a 60000 ms)
PANEL_METRICS_INTERVAL_MS=5000
# Endpoint Prometheus interno do Traefik; não publica porta no host
TRAEFIK_METRICS_PORT=8082

# PostgreSQL compartilhado (imagem 18 usa volume em /var/lib/postgresql)
POSTGRES_VERSION=18-bookworm@sha256:f1ea2a1a4fb7b68d4836be1fdcb8a6466a89b072158bf9d97663600538c294c5
POSTGRES_USER=infra_admin
POSTGRES_PASSWORD=troque-esta-senha-postgres
POSTGRES_DB=infra
# Não troque a versão principal sobre o mesmo volume sem migração.

# Cofre AES-256-GCM do painel: preserve esta chave junto com .panel-state
# Exemplo: openssl rand -hex 32 (não publique chave nem backups do cofre)
PANEL_VAULT_KEY=gere-com-openssl-rand-hex-32

# MariaDB: * inclui todos os bancos de aplicação; ou nomes separados por vírgula
BACKUP_DATABASES=*

# Backup PostgreSQL independente; destino local exclusivo
PG_BACKUP_ENABLED=false
PG_BACKUP_DIRECTORY=./backups/postgres
PG_BACKUP_SCHEDULE="30 3 * * *"
PG_BACKUP_TIMEZONE=America/Sao_Paulo
PG_BACKUP_RUN_ON_START=false
PG_BACKUP_RETENTION_DAYS=14
PG_BACKUP_MAX_AGE_HOURS=48
PG_BACKUP_DATABASES=*
PG_BACKUP_REMOTE_ENABLED=false
PG_BACKUP_REMOTE_PREFIX=laravel/postgres
PG_BACKUP_S3_PROVIDER=AWS
PG_BACKUP_S3_BUCKET=
PG_BACKUP_S3_REGION=us-east-1
PG_BACKUP_S3_ENDPOINT=
PG_BACKUP_S3_ACCESS_KEY_ID=
PG_BACKUP_S3_SECRET_ACCESS_KEY=
PG_BACKUP_S3_ENV_AUTH=false

# Portas dos bancos no host: 127.0.0.1 = somente a própria máquina/VPS.
# VPS/rede externa: use IP privado da VPS ou 0.0.0.0 e restrinja origens no firewall do provedor.
# As aplicações Docker continuam usando mariadb:3306 e postgres:5432.
MARIADB_BIND_ADDRESS=127.0.0.1
MARIADB_PORT=3306
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
# Engine padrão para NOVAS TABELAS MariaDB; não é uma opção por banco/schema.
MARIADB_DEFAULT_STORAGE_ENGINE=InnoDB
# Painel: PANEL_BIND_ADDRESS=127.0.0.1 mantém acesso local.
# Para acesso pelo IP da VPS: PANEL_BIND_ADDRESS=0.0.0.0 e PANEL_PORT=9090.
# HTTP: PANEL_COOKIE_SECURE=false; HTTPS: true. Veja acesso VPS/SSH no README.

# Tipos: php (padrão), node ou static. Importar .env no painel, salvar e aplicar.
STATIC_CADDY_VERSION=2-alpine@sha256:78bd35025c7ba85961dd149ae670315129954e77abe2383ac47c89106b35ade9
APP_TYPE=php
APP_START_COMMAND="npm start"
APP_WORKING_DIRECTORY=/var/www/html
APP_BUILD_DIRECTORY=dist
APP_SPA=false
APP_2_TYPE=php
APP_2_START_COMMAND="npm start"
APP_2_WORKING_DIRECTORY=/var/www/html
APP_2_BUILD_DIRECTORY=dist
APP_2_SPA=false
APP_3_TYPE=php
APP_3_START_COMMAND="npm start"
APP_3_WORKING_DIRECTORY=/var/www/html
APP_3_BUILD_DIRECTORY=dist
APP_3_SPA=false

# Painel por subdomínio: habilite, defina DNS e aplique/recrie Traefik e painel.
PANEL_PROXY_ENABLED=false
PANEL_DOMAIN=
PANEL_TLS_ENABLED=false
# VPS HTTPS: HTTP_BIND_ADDRESS=0.0.0.0, HTTP_PORT=80, HTTPS_PORT=443,
# TRAEFIK_TLS_ENABLED=true, ACME_EMAIL válido, PANEL_COOKIE_SECURE=true.
# Mantenha PANEL_BIND_ADDRESS=127.0.0.1 para acessar só pelo proxy.

# -----------------------------------------------------------------------------
# DIGESTS DAS IMAGENS
# -----------------------------------------------------------------------------
# Digests imutáveis: atualize conscientemente junto das versões.
FRANKENPHP_DIGEST=sha256:30061df7626971d597e45962269dfa7c077d972e96d1c4baf7c9259d5f7ecd55
COMPOSER_IMAGE=composer:2@sha256:8de2184c6de224f4689e8f80ed5f5edaf0030b6b8b7839a22a2bcb6722ac87d0
DOCKER_CLI_IMAGE=docker:cli@sha256:2357639ad1ea7d0194134bf3292622fd4e562483966ed674e5d7c945b5f3b28d

# -----------------------------------------------------------------------------
# IMPORTAÇÃO E EXPORTAÇÃO SQL
# -----------------------------------------------------------------------------
# Limite de upload SQL em bytes (1 GiB); import/export usa fila e streaming.
SQL_UPLOAD_MAX_BYTES=1073741824
# Limite máximo do SQL após descompactação (4 GiB); também vale para SQL sem compactação.
SQL_IMPORT_MAX_BYTES=4294967296

# -----------------------------------------------------------------------------
# ARMAZENAMENTO E MEMÓRIA
# -----------------------------------------------------------------------------
# Sistema de arquivos do host a monitorar (montado somente leitura no painel).
HOST_STORAGE_DIRECTORY=.
# Limites em MiB por serviço, gerenciados no painel. 0 = sem limite.
# CONTAINER_MEMORY_MARIADB=512m
# CONTAINER_MEMORY_PHP=512m

CONTAINER_MEMORY_PANEL=0
CONTAINER_MEMORY_TRAEFIK=0
CONTAINER_MEMORY_PHP=0
CONTAINER_MEMORY_NODE=0
CONTAINER_MEMORY_VITE=0
CONTAINER_MEMORY_SSR=0
CONTAINER_MEMORY_MARIADB=0
CONTAINER_MEMORY_VALKEY=0
CONTAINER_MEMORY_BACKUP=0
CONTAINER_MEMORY_POSTGRES=0
CONTAINER_MEMORY_BACKUP_POSTGRES=0
CONTAINER_MEMORY_PHPMYADMIN=0
CONTAINER_MEMORY_PHP_APP2=0
CONTAINER_MEMORY_NODE_APP2=0
CONTAINER_MEMORY_PHP_APP3=0
CONTAINER_MEMORY_NODE_APP3=0

# Rotação dos logs do Traefik usados na captura de requisições.
TRAEFIK_LOG_MAX_SIZE=10m
TRAEFIK_LOG_MAX_FILES=3

# Node das aplicações e ferramentas; independente do Node usado para construir o painel.
APP_NODE_VERSION=24-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9

# -----------------------------------------------------------------------------
# WEBSOCKETS
# -----------------------------------------------------------------------------
# WebSocket da aplicação principal (opcional; configure em Processos → WebSocket).
# Prepare Reverb no projeto ou um servidor Node antes de ativar.
# Aplicações adicionais usam APP_2_WEBSOCKET_*, APP_3_WEBSOCKET_* etc.
APP_WEBSOCKET_ENABLED=false
APP_WEBSOCKET_PROVIDER=reverb
APP_WEBSOCKET_ROUTING=path
APP_WEBSOCKET_DOMAIN=
APP_WEBSOCKET_PORT=8080
APP_WEBSOCKET_TLS=false
APP_WEBSOCKET_ORIGINS=localhost
APP_WEBSOCKET_NODE_COMMAND="npm run websocket"
APP_WEBSOCKET_NODE_PATH=/socket.io/

# Quotas opcionais do container HTTP principal; também configuráveis em Segurança.
# CPU 0 = sem quota; PIDs -1 = sem limite. Serviços adicionais usam seu nome em maiúsculas.
CONTAINER_CPUS_PHP=0
CONTAINER_PIDS_PHP=-1

# -----------------------------------------------------------------------------
# PROTEÇÃO DO LOGIN
# -----------------------------------------------------------------------------
# Segurança do login: falhas por IP em janela de 15 minutos; bloqueio temporário.
# Também editável em Segurança → Login do painel, sem reconstrução.
PANEL_LOGIN_MAX_ATTEMPTS=3
PANEL_LOGIN_BLOCK_SECONDS=60

# -----------------------------------------------------------------------------
# CPU E PROCESSOS DOS SERVIÇOS
# -----------------------------------------------------------------------------
# Quotas locais por serviço: CPU 0 = sem quota; PIDs -1 = sem limite.
CONTAINER_CPUS_BACKUP=0
CONTAINER_CPUS_BACKUP_POSTGRES=0
CONTAINER_CPUS_MARIADB=0
CONTAINER_CPUS_NODE=0
CONTAINER_CPUS_NODE_APP2=0
CONTAINER_CPUS_NODE_APP3=0
CONTAINER_CPUS_PANEL=0
CONTAINER_CPUS_PHPMYADMIN=0
CONTAINER_CPUS_PHP_APP2=0
CONTAINER_CPUS_PHP_APP3=0
CONTAINER_CPUS_POSTGRES=0
CONTAINER_CPUS_SSR=0
CONTAINER_CPUS_TRAEFIK=0
CONTAINER_CPUS_VALKEY=0
CONTAINER_CPUS_VITE=0
CONTAINER_PIDS_BACKUP=-1
CONTAINER_PIDS_BACKUP_POSTGRES=-1
CONTAINER_PIDS_MARIADB=-1
CONTAINER_PIDS_NODE=-1
CONTAINER_PIDS_NODE_APP2=-1
CONTAINER_PIDS_NODE_APP3=-1
CONTAINER_PIDS_PANEL=-1
CONTAINER_PIDS_PHPMYADMIN=-1
CONTAINER_PIDS_PHP_APP2=-1
CONTAINER_PIDS_PHP_APP3=-1
CONTAINER_PIDS_POSTGRES=-1
CONTAINER_PIDS_SSR=-1
CONTAINER_PIDS_TRAEFIK=-1
CONTAINER_PIDS_VALKEY=-1
CONTAINER_PIDS_VITE=-1

# -----------------------------------------------------------------------------
# RECURSOS OPCIONAIS ADMINISTRADOS NO PAINEL
# -----------------------------------------------------------------------------
# Mercure: desativado por padrão, administrado em Processos → Mercure.
# Configurações e chaves próprias ficam em .panel-state/mercure/, fora do Git.
# Usa a imagem FrankenPHP fixada acima e as redes existentes, sem porta pública extra.
